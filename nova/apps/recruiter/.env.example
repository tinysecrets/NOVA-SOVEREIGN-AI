# Recruiter — Wah-Lah player acquisition worker (hierarchy: reports up to Boss)
#
# Sender identity (must be a verified Resend domain that wah-lah.com owns)
BOT_EMAIL=ember@wah-lah.com
BOSS_EMAIL=owner@example.com
BOT_NAME=Ember
RESEND_API_KEY=

# Optional BYOK key; model routing is constrained to OpenRouter :free IDs.
# If this key is absent, the recruiter falls back to local Ollama only.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_HIGH=nvidia/nemotron-3.5-lightning:free
# Local fallback (no cloud inference when the OpenRouter free route is unavailable)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:8b

# Delivery channels. Wire only what you want live.
DISCORD_BOT_TOKEN=
DISCORD_INVITE_URL=https://discord.gg/your-wah-lah-server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INVITE_URL=https://t.me/your-wah-lah-channel

# Official handles traffic points to
URL_APP=https://app.wah-lah.com
URL_HOME=https://wah-lah.com

# Send controls (the safety rails)
RECRUITER_DRY_RUN=true
RECRUITER_APPROVAL_GATE=true
RECRUITER_DAILY_CAP=50
RECRUITER_MAX_PER_HOUR=15
RECRUITER_HEARTBEAT_SEC=3600
RECRUITER_DATA_DIR=./data

# Live email is blocked until a real, owner-supplied postal address is configured.
POSTAL_ADDRESS=
# Required for signed one-click unsubscribe links; generate a random secret of 32+ chars.
UNSUBSCRIBE_SECRET=
# Public HTTPS base URL for the recruiter API (the code appends /api/recruiter/unsubscribe).
UNSUBSCRIBE_BASE_URL=

# Optional Mongo (falls back to JSONL in RECRUITER_DATA_DIR)
MONGO_URL=
DB_NAME=recruiter